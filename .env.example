# ===== SMART on FHIR Configuration =====
# Works with any FHIR R4-compliant EHR (Epic, Cerner, Allscripts, athenahealth, etc.)
# See docs/EHR_PROVIDER_SETUP.md for provider-specific configuration examples

# Your EHR client credentials (from app registration)
FHIR_CLIENT_ID=your_client_id_here
FHIR_CLIENT_SECRET=                      # Optional, leave empty for public clients using PKCE

# FHIR API endpoints (example shown: Epic sandbox)
# Replace these with your EHR's specific URLs from your app registration
FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
FHIR_AUTH_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize
FHIR_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
FHIR_ISS=                                # Optional, for EHR-initiated launch mode

# OAuth redirect URI (must match exactly what you registered in your EHR app)
REDIRECT_URI=http://localhost:8000/auth/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# SMART scopes (adjust based on your EHR's supported capabilities)
SMART_SCOPES=launch openid fhirUser patient/Patient.read patient/Observation.read patient/Observation.write patient/Condition.read patient/MedicationRequest.read patient/Appointment.read patient/QuestionnaireResponse.read patient/QuestionnaireResponse.write patient/CarePlan.read patient/Task.write

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Database (docker-compose overrides this for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/peripartum_db

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=82e511c0cb507df56d72ab28214265e717b018f36b117a9aeed58e9a1e69692a
COOKIE_SECURE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
