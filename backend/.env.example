# ===== SMART on FHIR Configuration =====
# Works with any FHIR R4-compliant EHR (Epic, Cerner, Allscripts, athenahealth, etc.)
# See docs/EHR_PROVIDER_SETUP.md for provider-specific configuration examples

# IMPORTANT: These credentials are configured in backend/app/utils/config.py
# For production Railway deployment, you only need to provide:
#  - ANTHROPIC_API_KEY
#  - SESSION_SECRET_KEY
#  - REDIRECT_URI
#  - COOKIE_SECURE
# The provider-specific configs (client IDs, URLs, scopes) are in code for sandbox testing.
# Update PROVIDER_CONFIGS in backend/app/utils/config.py with production credentials.

# OAuth redirect URI (must match exactly what you registered in your EHR apps)
# Local dev: http://localhost:8000/auth/callback
# Railway production: https://your-backend.railway.app/auth/callback
REDIRECT_URI=http://localhost:8000/auth/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Anthropic AI for conversational check-ins and hypothesis generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Database (docker-compose overrides this for local dev)
# Railway automatically injects DATABASE_URL when you add a Postgres plugin
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/peripartum_db

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=82e511c0cb507df56d72ab28214265e717b018f36b117a9aeed58e9a1e69692a
COOKIE_SECURE=false  # Set to true in production (Railway deployment script does this)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
